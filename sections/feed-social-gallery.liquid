{% comment %}
  Instagram "Follow us" / shoppable gallery.
  A grid of square posts (image blocks), each optionally linking to a product or
  an external Instagram post. A UGC app (Yotpo, Pixlee, etc.) can later replace
  the blocks with live tagged content using the same grid markup.
{% endcomment %}

{%- liquid
  case section.settings.columns
    when '3'
      assign cols = 'grid-cols-3'
    when '5'
      assign cols = 'grid-cols-3 md:grid-cols-5'
    else
      assign cols = 'grid-cols-2 md:grid-cols-4'
  endcase
-%}

<section
  class="feed-social color-{{ section.settings.color_scheme }}"
  style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;"
>
  <div class="feed-container">
    <div class="mb-5 flex flex-col items-center gap-1 text-center">
      {%- if section.settings.heading != blank -%}
        <h2 class="text-lg! font-semibold! text-feed-primary! dark:text-white!">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.handle != blank -%}
        {%- if section.settings.handle_url != blank -%}
          <a
            href="{{ section.settings.handle_url }}"
            class="text-sm font-medium text-feed-link hover:underline"
            target="_blank"
            rel="noopener"
          >
            {{ section.settings.handle | escape }}
          </a>
        {%- else -%}
          <span class="text-sm font-medium text-feed-link">{{ section.settings.handle | escape }}</span>
        {%- endif -%}
      {%- endif -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      <ul role="list" class="feed-grid {{ cols }} gap-1 md:gap-2">
        {%- for block in section.blocks -%}
          <li {{ block.shopify_attributes }}>
            {%- capture post_inner -%}
              <div class="group relative aspect-square overflow-hidden bg-gray-100 dark:bg-gray-800">
                {%- if block.settings.image != blank -%}
                  {{
                    block.settings.image
                    | image_url: width: 600
                    | image_tag:
                      loading: 'lazy',
                      widths: '200, 300, 400, 600',
                      sizes: '(min-width: 768px) 20vw, 50vw',
                      class: 'h-full w-full object-cover transition-transform duration-300 group-hover:scale-105'
                  }}
                {%- else -%}
                  {{ 'lifestyle-1' | placeholder_svg_tag: 'h-full w-full object-cover' }}
                {%- endif -%}
                <span class="absolute inset-0 flex items-center justify-center bg-black/30 opacity-0 transition-opacity duration-200 group-hover:opacity-100">
                  <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="1.5" class="h-7 w-7">
                    <rect x="3" y="3" width="18" height="18" rx="5" />
                    <circle cx="12" cy="12" r="4" />
                    <circle cx="17.5" cy="6.5" r="1" fill="white" />
                  </svg>
                </span>
              </div>
            {%- endcapture -%}

            {%- if block.settings.link != blank -%}
              <a href="{{ block.settings.link }}" class="block" aria-label="{{ 'feed.social.view_post' | t: index: forloop.index }}">{{ post_inner }}</a>
            {%- else -%}
              {{ post_inner }}
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    {%- else -%}
      <ul role="list" class="feed-grid {{ cols }} gap-1 md:gap-2">
        {%- for i in (1..8) -%}
          {%- assign ph = i | minus: 1 | modulo: 2 | plus: 1 -%}
          <li>
            <div class="aspect-square overflow-hidden bg-gray-100 dark:bg-gray-800">
              {{ 'lifestyle-' | append: ph | placeholder_svg_tag: 'h-full w-full object-cover text-gray-300' }}
            </div>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Instagram gallery",
  "tag": "section",
  "class": "section-feed-social",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "default": "Follow us",
      "label": "t:sections.featured-collection.settings.title.label"
    },
    {
      "type": "text",
      "id": "handle",
      "default": "@yourstore",
      "label": "Instagram handle"
    },
    {
      "type": "url",
      "id": "handle_url",
      "label": "Instagram profile link"
    },
    {
      "type": "select",
      "id": "columns",
      "options": [
        { "value": "3", "label": "t:sections.all.heading_size.options__1.label" },
        { "value": "4", "label": "t:sections.all.heading_size.options__2.label" },
        { "value": "5", "label": "t:sections.all.heading_size.options__3.label" }
      ],
      "default": "4",
      "label": "Columns"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "default": "scheme-1",
      "label": "t:sections.all.colors.label"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 28
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 28
    }
  ],
  "blocks": [
    {
      "type": "post",
      "name": "Post",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:sections.image-with-text.settings.image.label"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "Instagram gallery",
      "blocks": [
        { "type": "post" }, { "type": "post" }, { "type": "post" }, { "type": "post" },
        { "type": "post" }, { "type": "post" }, { "type": "post" }, { "type": "post" }
      ]
    }
  ]
}
{% endschema %}
