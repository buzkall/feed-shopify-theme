{% comment %}
  Instagram-inspired footer.
  Stacked on mobile, multi-column on desktop. Columns are merchant-managed link
  lists (blocks). Brand column shows the logo/name + social icons; the bottom bar
  carries copyright, shop policy links and payment icons.
{% endcomment %}

<footer
  class="feed-footer color-{{ section.settings.color_scheme }} border-t border-feed-border dark:border-gray-800"
  style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;"
  role="contentinfo"
>
  <div class="feed-container">
    <div class="feed-footer-grid">
      {%- comment -%} Brand column {%- endcomment -%}
      <div class="col-span-2 md:col-span-1">
        <a href="{{ routes.root_url }}" class="inline-block">
          {%- if settings.logo != blank -%}
            {%- assign logo_alt = shop.name | escape -%}
            {{
              settings.logo
              | image_url: width: 200
              | image_tag: class: 'h-8 w-auto', alt: logo_alt, loading: 'lazy'
            }}
          {%- else -%}
            <span class="text-lg font-semibold text-feed-primary dark:text-white">{{ shop.name }}</span>
          {%- endif -%}
        </a>

        {%- if section.settings.show_social -%}
          {% render 'feed-social-icons', class: 'feed-footer__social mt-4' %}
        {%- endif -%}
      </div>

      {%- comment -%} Merchant-configured columns {%- endcomment -%}
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'menu' -%}
            <div {{ block.shopify_attributes }}>
              {%- if block.settings.heading != blank -%}
                <h2 class="mb-3 text-sm! font-semibold! uppercase tracking-wide! text-feed-primary! dark:text-white!">
                  {{ block.settings.heading | escape }}
                </h2>
              {%- endif -%}
              {%- if block.settings.menu != blank -%}
                <ul role="list" class="space-y-2">
                  {%- for link in block.settings.menu.links -%}
                    <li>
                      <a
                        href="{{ link.url }}"
                        class="text-sm text-feed-secondary transition-colors hover:text-feed-primary dark:text-gray-400 dark:hover:text-white"
                      >
                        {{ link.title | escape }}
                      </a>
                    </li>
                  {%- endfor -%}
                </ul>
              {%- endif -%}
            </div>
          {%- when 'text' -%}
            <div {{ block.shopify_attributes }}>
              {%- if block.settings.heading != blank -%}
                <h2 class="mb-3 text-sm! font-semibold! uppercase tracking-wide! text-feed-primary! dark:text-white!">
                  {{ block.settings.heading | escape }}
                </h2>
              {%- endif -%}
              {%- if block.settings.subtext != blank -%}
                <div class="feed-footer__text text-sm text-feed-secondary dark:text-gray-400">{{ block.settings.subtext }}</div>
              {%- endif -%}
            </div>
        {%- endcase -%}
      {%- endfor -%}
    </div>

    {%- comment -%} Bottom bar {%- endcomment -%}
    <div class="mt-10 border-t border-feed-border pt-6 dark:border-gray-800">
      <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
        <div class="flex flex-col gap-2 text-xs text-feed-secondary md:flex-row md:items-center md:gap-4 dark:text-gray-400">
          <p>&copy; {{ 'now' | date: '%Y' }} {{ shop.name | escape }}</p>

          {%- if section.settings.show_policy and shop.policies.size > 0 -%}
            <ul role="list" class="flex flex-wrap gap-x-4 gap-y-1">
              {%- for policy in shop.policies -%}
                {%- if policy != blank -%}
                  <li>
                    <a href="{{ policy.url }}" class="transition-colors hover:text-feed-primary dark:hover:text-white">
                      {{ policy.title | escape }}
                    </a>
                  </li>
                {%- endif -%}
              {%- endfor -%}
            </ul>
          {%- endif -%}
        </div>

        {%- if section.settings.payment_enable and shop.enabled_payment_types.size > 0 -%}
          <ul class="flex flex-wrap items-center gap-2" role="list">
            {%- for type in shop.enabled_payment_types -%}
              <li class="inline-flex h-6 w-[38px] items-center justify-center">
                {{ type | payment_type_svg_tag: class: 'h-6 w-auto' }}
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "t:sections.footer.name",
  "tag": "footer",
  "class": "section-feed-footer",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "default": "scheme-1",
      "label": "t:sections.all.colors.label"
    },
    {
      "type": "checkbox",
      "id": "show_social",
      "default": true,
      "label": "t:sections.footer.settings.show_social.label",
      "info": "t:sections.footer.settings.show_social.info"
    },
    {
      "type": "checkbox",
      "id": "show_policy",
      "default": true,
      "label": "t:sections.footer.settings.show_policy.label",
      "info": "t:sections.footer.settings.show_policy.info"
    },
    {
      "type": "checkbox",
      "id": "payment_enable",
      "default": true,
      "label": "t:sections.footer.settings.payment_enable.label"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "t:sections.footer.blocks.link_list.name",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "default": "t:sections.footer.blocks.link_list.settings.heading.default",
          "label": "t:sections.footer.blocks.link_list.settings.heading.label"
        },
        {
          "type": "link_list",
          "id": "menu",
          "default": "footer",
          "label": "t:sections.footer.blocks.link_list.settings.menu.label"
        }
      ]
    },
    {
      "type": "text",
      "name": "t:sections.footer.blocks.text.name",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "default": "t:sections.footer.blocks.text.settings.heading.default",
          "label": "t:sections.footer.blocks.text.settings.heading.label"
        },
        {
          "type": "richtext",
          "id": "subtext",
          "default": "t:sections.footer.blocks.text.settings.subtext.default",
          "label": "t:sections.footer.blocks.text.settings.subtext.label"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.footer.name",
      "blocks": [
        {
          "type": "menu",
          "settings": {
            "menu": "footer"
          }
        },
        {
          "type": "menu",
          "settings": {
            "menu": "main-menu"
          }
        }
      ]
    }
  ]
}
{% endschema %}
