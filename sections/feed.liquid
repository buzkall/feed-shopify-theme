{% comment %}
  Instagram-inspired product grid feed.
  Single column on mobile (full-width "posts"), 3 columns on desktop.
  Infinite scroll is powered by the Shopify Section Rendering API + IntersectionObserver,
  with a real paginated "Load more" link as the no-JS / keyboard fallback.
{% endcomment %}

{%- liquid
  # Use the picked collection, or fall back to the current collection (collection template)
  assign feed_collection = section.settings.collection | default: collection
  assign per_page = section.settings.products_per_page | at_least: 1
  assign feed_layout = section.settings.layout | default: 'grid'
-%}

<div
  class="feed color-{{ section.settings.color_scheme }}"
  style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;"
>
  <div class="feed-container">
    {%- if section.settings.heading != blank -%}
      <h2 class="mb-4 px-1 text-lg! font-semibold! text-feed-primary! dark:text-white!">
        {{ section.settings.heading | escape }}
      </h2>
    {%- endif -%}

    {%- if section.settings.enable_filtering and feed_collection != blank -%}
      {% render 'feed-facets', facet_collection: feed_collection %}
    {%- endif -%}

    {%- if feed_collection != blank and feed_collection.products_count > 0 -%}
      {%- paginate feed_collection.products by per_page -%}
        <div x-data="feed({ totalPages: {{ paginate.pages }}, sectionId: '{{ section.id }}' })">
          {%- if feed_layout == 'posts' -%}
            <div data-feed-grid class="feed-post-feed">
              {%- for product in feed_collection.products -%}
                {% render 'feed-post-card', card_product: product %}
              {%- endfor -%}
            </div>
          {%- else -%}
            <ul data-feed-grid role="list" class="grid grid-cols-1 items-start gap-5 sm:grid-cols-2 lg:grid-cols-3">
              {%- for product in feed_collection.products -%}
                <li>
                  {% render 'feed-post-card', card_product: product %}
                </li>
              {%- endfor -%}
            </ul>
          {%- endif -%}

          {%- if paginate.next -%}
            <div x-ref="sentinel" class="mt-6 flex justify-center">
              <a
                href="{{ paginate.next.url }}"
                @click="onLoadMore($event)"
                x-show="!loading"
                class="feed-button-secondary"
              >
                {{ 'general.pagination.load_more' | t }}
              </a>
              <span x-show="loading" x-cloak class="py-2 text-feed-secondary dark:text-gray-300">
                {{ 'accessibility.loading' | t }}
              </span>
            </div>
          {%- endif -%}
        </div>
      {%- endpaginate -%}
    {%- else -%}
      {%- comment -%} Onboarding placeholder grid shown before a collection is chosen {%- endcomment -%}
      <ul role="list" class="feed-grid">
        {%- for i in (1..6) -%}
          {%- assign ph = i | minus: 1 | modulo: 4 | plus: 1 -%}
          <li>
            <div class="aspect-square overflow-hidden rounded-sm bg-gray-100 dark:bg-gray-800">
              {{ 'product-apparel-' | append: ph | placeholder_svg_tag: 'h-full w-full object-cover text-gray-300' }}
            </div>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</div>

{%- comment -%} Self-contained AlpineJS component: infinite scroll via Section Rendering API {%- endcomment -%}
<script>
  document.addEventListener('alpine:init', () => {
    Alpine.data('feed', (opts) => ({
      page: 2,
      totalPages: opts.totalPages,
      sectionId: opts.sectionId,
      loading: false,
      useApi: true,
      observer: null,
      init() {
        this.scrollKey = 'feed-scroll:' + location.pathname;
        this.bindScrollSave();
        this.restoreScroll();
        if (this.page > this.totalPages || !this.$refs.sentinel) return;
        this.observer = new IntersectionObserver(
          (entries) => {
            if (entries[0].isIntersecting) this.loadMore();
          },
          { rootMargin: '600px' }
        );
        this.observer.observe(this.$refs.sentinel);
      },
      // Persist scroll position + how many pages are loaded, so we can return to
      // the same spot after visiting a product and coming back.
      bindScrollSave() {
        let ticking = false;
        const save = () => {
          ticking = false;
          try {
            sessionStorage.setItem(this.scrollKey, JSON.stringify({ y: window.scrollY, page: this.page }));
          } catch (e) {}
        };
        window.addEventListener(
          'scroll',
          () => {
            if (!ticking) {
              ticking = true;
              requestAnimationFrame(save);
            }
          },
          { passive: true }
        );
      },
      async restoreScroll() {
        // Only restore when arriving back from a product page (not on a fresh visit).
        if (!document.referrer.includes('/products/')) return;
        let saved;
        try {
          saved = JSON.parse(sessionStorage.getItem(this.scrollKey) || 'null');
        } catch (e) {}
        if (!saved) return;
        // Re-load the pages that were present before navigating away.
        let guard = 0;
        while (this.useApi && this.page <= this.totalPages && this.page < saved.page && guard < 50) {
          await this.loadMore();
          guard += 1;
        }
        // aspect-square wrappers reserve height, so the layout is stable before images load.
        requestAnimationFrame(() => window.scrollTo(0, saved.y));
      },
      // While the Section Rendering API works, intercept the click and append in place.
      // After it has failed once, let the link navigate normally (paginated fallback).
      onLoadMore(event) {
        if (this.useApi) {
          event.preventDefault();
          this.loadMore();
        }
      },
      async loadMore() {
        if (this.loading || !this.useApi || this.page > this.totalPages) return;
        this.loading = true;
        try {
          const url = `${location.pathname}?sections=${this.sectionId}&page=${this.page}`;
          const res = await fetch(url);
          if (!res.ok) throw new Error(`HTTP ${res.status}`);
          const markup = (await res.json())[this.sectionId];
          if (!markup) throw new Error('empty section markup');
          const doc = new DOMParser().parseFromString(markup, 'text/html');
          const items = doc.querySelectorAll('[data-feed-grid] > *');
          if (!items.length) throw new Error('no items returned');
          const grid = this.$el.querySelector('[data-feed-grid]');
          items.forEach((node) => grid.appendChild(node));
          this.page += 1;
          if (this.page > this.totalPages) {
            this.observer?.disconnect();
            this.$refs.sentinel?.remove();
          }
        } catch (err) {
          // Section Rendering API unavailable (e.g. password-protected preview or
          // local dev): stop auto-loading and let "Load more" fall back to paginated navigation.
          console.warn('feed: falling back to paginated navigation —', err.message);
          this.useApi = false;
          this.observer?.disconnect();
        } finally {
          this.loading = false;
        }
      },
    }));

    {%- comment -%} Instagram "post" card (used when layout = posts) {%- endcomment -%}
    Alpine.data('feedPostCard', ({ productId, likeBase, productHandle, productUrl, variantId, imageCount }) => ({
      liked: false,
      likeCount: likeBase,
      saved: false,
      shareCopied: false,
      showHeart: false,
      menuOpen: false,
      lastTouchEnd: 0,
      lastTouchStart: 0,
      active: 0,
      imageCount: imageCount,
      init() {
        this.liked = localStorage.getItem('feed-like-' + productId) === '1';
        this.likeCount = likeBase + (this.liked ? 1 : 0);
        this.saved = JSON.parse(localStorage.getItem('feed-saved') || '[]').includes(productHandle);
      },
      // Carousel: native scroll-snap drives the active dot; arrows scroll programmatically.
      onScroll() {
        const el = this.$refs.track;
        if (!el) return;
        this.active = Math.round(el.scrollLeft / el.clientWidth);
      },
      goTo(index) {
        const el = this.$refs.track;
        if (!el) return;
        const i = Math.max(0, Math.min(this.imageCount - 1, index));
        el.scrollTo({ left: i * el.clientWidth, behavior: 'smooth' });
        this.active = i;
      },
      toggleLike() {
        this.liked = !this.liked;
        this.likeCount += this.liked ? 1 : -1;
        localStorage.setItem('feed-like-' + productId, this.liked ? '1' : '0');
      },
      toggleSave() {
        let list = JSON.parse(localStorage.getItem('feed-saved') || '[]');
        if (list.includes(productHandle)) {
          list = list.filter((h) => h !== productHandle);
          this.saved = false;
        } else {
          list.push(productHandle);
          this.saved = true;
        }
        localStorage.setItem('feed-saved', JSON.stringify(list));
      },
      addToCart() {
        if (!variantId) return;
        this.menuOpen = false;
        this.$store.cart.add(variantId, 1);
      },
      async share() {
        const url = window.location.origin + productUrl;
        if (navigator.share) {
          try {
            await navigator.share({ title: productHandle, url: url });
            return;
          } catch (e) {
            // User dismissed the native share sheet — don't fall back to copying.
            if (e && e.name === 'AbortError') return;
          }
        }
        // No Web Share API (most desktops) or it failed: copy the link and confirm.
        try {
          await navigator.clipboard.writeText(url);
        } catch (e) {
          const ta = document.createElement('textarea');
          ta.value = url;
          ta.style.position = 'fixed';
          ta.style.opacity = '0';
          document.body.appendChild(ta);
          ta.select();
          try { document.execCommand('copy'); } catch (e2) {}
          ta.remove();
        }
        this.shareCopied = true;
        setTimeout(() => (this.shareCopied = false), 2000);
      },
      doubleTapLike() {
        if (!this.liked) this.toggleLike();
        this.showHeart = true;
        setTimeout(() => (this.showHeart = false), 800);
      },
      onTouchStart() {
        this.lastTouchStart = Date.now();
      },
      onTouchEnd(e) {
        const now = Date.now();
        if (now - this.lastTouchEnd < 350 && now - this.lastTouchStart < 200) {
          e.preventDefault();
          this.doubleTapLike();
        }
        this.lastTouchEnd = now;
      },
    }));
  });
</script>

{% schema %}
{
  "name": "t:sections.feed.name",
  "tag": "section",
  "class": "section-feed",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.featured-collection.settings.title.label",
      "default": "Feed"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "t:sections.featured-collection.settings.collection.label"
    },
    {
      "type": "range",
      "id": "products_per_page",
      "min": 3,
      "max": 24,
      "step": 3,
      "default": 9,
      "label": "t:sections.feed.settings.products_per_page.label"
    },
    {
      "type": "select",
      "id": "layout",
      "options": [
        { "value": "grid", "label": "t:sections.feed.settings.layout.options__1.label" },
        { "value": "posts", "label": "t:sections.feed.settings.layout.options__2.label" }
      ],
      "default": "grid",
      "label": "t:sections.feed.settings.layout.label"
    },
    {
      "type": "checkbox",
      "id": "enable_filtering",
      "default": false,
      "label": "t:sections.main-collection-product-grid.settings.enable_filtering.label"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "default": "scheme-1",
      "label": "t:sections.all.colors.label"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 24
    }
  ],
  "presets": [
    {
      "name": "t:sections.feed.presets.name"
    }
  ]
}
{% endschema %}
