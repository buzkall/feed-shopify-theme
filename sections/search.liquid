{% comment %}
  This section is used in the search template to render search results for
  products, articles, and pages.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/search
{% endcomment %}

<div class="feed-container py-8 md:py-12">
  <h1 class="mb-6 text-center text-2xl font-semibold text-feed-primary md:text-3xl dark:text-white">
    {{ 'search.results_title' | t }}
  </h1>

  <form action="{{ routes.search_url }}" method="get" role="search" class="mx-auto max-w-2xl">
    <label for="search-input" class="sr-only">{{ 'search.title' | t }}</label>
    <div class="flex items-center rounded-md border border-feed-border bg-feed-bg px-4 dark:border-gray-700 dark:bg-feed-dark-elevated">
      <input
        id="search-input"
        type="search"
        name="q"
        value="{{ search.terms | escape }}"
        placeholder="{{ 'search.placeholder' | t }}"
        class="h-12 w-full bg-transparent text-feed-primary placeholder:text-feed-secondary focus:outline-none dark:text-white"
      >
      <button type="submit" class="shrink-0 pl-3 text-feed-secondary hover:text-feed-primary dark:hover:text-white" aria-label="{{ 'search.submit' | t }}">
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <circle cx="11" cy="11" r="7" /><path stroke-linecap="round" d="m20 20-3.5-3.5" />
        </svg>
      </button>
    </div>
  </form>

  {%- if search.performed -%}
    {%- if search.results_count == 0 -%}
      <p class="py-16 text-center text-feed-secondary dark:text-gray-400">
        {{ 'search.no_results_html' | t: terms: search.terms }}
      </p>
    {%- else -%}
      <p class="mt-8 mb-6 text-sm text-feed-secondary dark:text-gray-400">
        {{ 'search.results_for_html' | t: terms: search.terms, count: search.results_count }}
      </p>

      {%- paginate search.results by 18 -%}
        <ul role="list" class="grid grid-cols-1 items-start gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {%- for result in search.results -%}
            <li>
              {%- if result.object_type == 'product' -%}
                {%- comment -%} Same Instagram post card as the home feed {%- endcomment -%}
                {% render 'feed-post-card', card_product: result %}
              {%- else -%}
                {%- comment -%} Articles / pages: simple card matching the feed look {%- endcomment -%}
                {%- assign featured_image = result.featured_media.preview_image | default: result.featured_image | default: result.image -%}
                <a href="{{ result.url }}" class="group block overflow-hidden rounded-lg border border-feed-border bg-white pb-2 dark:border-gray-800 dark:bg-feed-dark-elevated">
                  <div class="aspect-square overflow-hidden bg-gray-100 dark:bg-gray-800">
                    {%- if featured_image -%}
                      {{
                        featured_image
                        | image_url: width: 800
                        | image_tag:
                          loading: 'lazy',
                          widths: '300, 400, 600, 800',
                          sizes: '(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw',
                          class: 'h-full w-full object-cover transition-transform duration-300 group-hover:scale-105',
                          alt: result.title | escape
                      }}
                    {%- else -%}
                      {{ 'image' | placeholder_svg_tag: 'h-full w-full object-cover' }}
                    {%- endif -%}
                  </div>
                  <p class="truncate px-4 pt-3 font-medium text-feed-primary dark:text-gray-100">{{ result.title | escape }}</p>
                </a>
              {%- endif -%}
            </li>
          {%- endfor -%}
        </ul>

        {%- if paginate.pages > 1 -%}
          <nav class="mt-10 flex justify-center gap-4 text-sm text-feed-primary dark:text-white" role="navigation">
            {%- if paginate.previous -%}
              <a href="{{ paginate.previous.url }}" class="underline underline-offset-4 hover:opacity-70">{{ paginate.previous.title }}</a>
            {%- endif -%}
            {%- if paginate.next -%}
              <a href="{{ paginate.next.url }}" class="underline underline-offset-4 hover:opacity-70">{{ paginate.next.title }}</a>
            {%- endif -%}
          </nav>
        {%- endif -%}
      {%- endpaginate -%}
    {%- endif -%}
  {%- endif -%}
</div>

{% schema %}
{
  "name": "t:general.search",
  "settings": []
}
{% endschema %}
