{% comment %}
  Comment-style product reviews (display).
  Reviews are authored as blocks (merchant-curated, or replaceable by a reviews
  app that outputs the same markup). Aggregate rating + star display, client-side
  sort and show-more pagination. Live submission/moderation requires a reviews app.
{% endcomment %}

{%- liquid
  assign review_count = section.blocks.size
  assign rating_sum = 0
  for block in section.blocks
    assign rating_sum = rating_sum | plus: block.settings.rating
  endfor
  assign avg = 0
  if review_count > 0
    assign avg = rating_sum | times: 1.0 | divided_by: review_count
  endif
-%}

<section
  id="feed-reviews"
  class="feed-reviews color-{{ section.settings.color_scheme }}"
  style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;"
>
  <div class="feed-container">
    {%- if section.settings.heading != blank -%}
      <h2 class="mb-5 text-lg! font-semibold! text-feed-primary! dark:text-white!">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}

    {%- if review_count > 0 -%}
      <div class="mb-6 flex items-center gap-3">
        <span class="text-3xl font-semibold text-feed-primary dark:text-white">{{ avg | round: 1 }}</span>
        {% render 'feed-stars', rating: avg, size: 'h-5 w-5' %}
        <span class="text-sm text-feed-secondary dark:text-gray-400">{{ 'products.reviews.based_on' | t: count: review_count }}</span>
      </div>

      <div x-data="feedReviews()">
        <div class="mb-5 flex items-center gap-2">
          <label class="text-sm text-feed-secondary dark:text-gray-400" for="feed-reviews-sort">{{ 'products.facets.sort_by_label' | t }}</label>
          <select
            id="feed-reviews-sort"
            x-model="sortBy"
            @change="applySort()"
            class="rounded-full border border-feed-border bg-white px-3 py-1.5 text-sm text-feed-primary dark:border-gray-700 dark:bg-feed-dark-elevated dark:text-gray-100"
          >
            <option value="recent">{{ 'products.reviews.sort_recent' | t }}</option>
            <option value="rating">{{ 'products.reviews.sort_rated' | t }}</option>
          </select>
        </div>

        <script type="application/json" x-ref="reviewsData">
          [
            {%- for block in section.blocks -%}
              {
                "author": {{ block.settings.author | default: 'Anonymous' | json }},
                "rating": {{ block.settings.rating | default: 5 }},
                "date": {{ block.settings.date | default: '' | json }},
                "body": {{ block.settings.body | strip_html | json }},
                "index": {{ forloop.index0 }}
              }{%- unless forloop.last -%},{%- endunless -%}
            {%- endfor -%}
          ]
        </script>

        <ul role="list" class="space-y-5">
          <template x-for="r in visibleReviews" :key="r.index">
            <li class="flex gap-3">
              <span
                class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-gradient-to-tr from-yellow-400 via-pink-500 to-purple-600 text-sm font-semibold text-white"
                x-text="(r.author || '?').charAt(0).toUpperCase()"
              ></span>
              <div class="min-w-0">
                <div class="flex flex-wrap items-center gap-x-2 gap-y-1">
                  <span class="text-sm font-semibold text-feed-primary dark:text-gray-100" x-text="r.author"></span>
                  <span class="inline-flex items-center" role="img" :aria-label="'{{ 'accessibility.star_reviews_info' | t: rating_value: 'RATING_VALUE', rating_max: 5 }}'.replace('RATING_VALUE', r.rating)">
                    <template x-for="n in 5" :key="n">
                      <svg aria-hidden="true" viewBox="0 0 24 24" stroke-width="1.5" class="h-3.5 w-3.5" :class="n <= r.rating ? 'fill-yellow-400 stroke-yellow-400' : 'fill-none stroke-gray-300 dark:stroke-gray-600'">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M11.48 3.5a.562.562 0 011.04 0l2.125 5.111a.563.563 0 00.475.345l5.518.442c.499.04.701.663.321.988l-4.204 3.602a.563.563 0 00-.182.557l1.285 5.385a.562.562 0 01-.84.61l-4.725-2.885a.562.562 0 00-.586 0L6.982 20.54a.562.562 0 01-.84-.61l1.285-5.386a.562.562 0 00-.182-.557l-4.204-3.602a.563.563 0 01.321-.988l5.518-.442a.563.563 0 00.475-.345L11.48 3.5z" />
                      </svg>
                    </template>
                  </span>
                  <span class="text-xs text-feed-secondary dark:text-gray-500" x-text="r.date"></span>
                </div>
                <p class="mt-1 whitespace-pre-line text-sm text-feed-primary dark:text-gray-200" x-text="r.body"></p>
              </div>
            </li>
          </template>
        </ul>

        <button
          type="button"
          x-show="visibleCount < reviews.length"
          @click="visibleCount = visibleCount + 4"
          class="feed-button-secondary mt-6"
        >
          {{ 'general.pagination.load_more' | t }}
        </button>
      </div>
    {%- else -%}
      <p class="text-sm text-feed-secondary dark:text-gray-400">{{ 'products.reviews.empty' | t }}</p>
    {%- endif -%}
  </div>
</section>

<script>
  document.addEventListener('alpine:init', () => {
    Alpine.data('feedReviews', () => ({
      reviews: [],
      sortBy: 'recent',
      visibleCount: 4,
      init() {
        this.reviews = JSON.parse(this.$refs.reviewsData.textContent);
        this.applySort();
      },
      applySort() {
        if (this.sortBy === 'rating') {
          this.reviews.sort((a, b) => b.rating - a.rating || a.index - b.index);
        } else {
          this.reviews.sort((a, b) => a.index - b.index);
        }
      },
      get visibleReviews() {
        return this.reviews.slice(0, this.visibleCount);
      },
    }));
  });
</script>

{% schema %}
{
  "name": "t:sections.feed_reviews.name",
  "tag": "section",
  "class": "section-feed-reviews",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "default": "Reviews",
      "label": "t:sections.featured-collection.settings.title.label"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "default": "scheme-1",
      "label": "t:sections.all.colors.label"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 28
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 28
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "t:sections.feed_reviews.blocks.review.name",
      "settings": [
        {
          "type": "text",
          "id": "author",
          "default": "Jane D.",
          "label": "t:sections.feed_reviews.blocks.review.settings.author.label"
        },
        {
          "type": "range",
          "id": "rating",
          "min": 1,
          "max": 5,
          "step": 1,
          "default": 5,
          "label": "t:sections.feed_reviews.blocks.review.settings.rating.label"
        },
        {
          "type": "text",
          "id": "date",
          "label": "t:sections.feed_reviews.blocks.review.settings.date.label"
        },
        {
          "type": "textarea",
          "id": "body",
          "default": "Absolutely love it!",
          "label": "t:sections.feed_reviews.blocks.review.settings.body.label"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.feed_reviews.name",
      "blocks": [
        { "type": "review", "settings": { "author": "Mia R.", "rating": 5, "date": "2 days ago", "body": "Obsessed with this — exactly as pictured and amazing quality." } },
        { "type": "review", "settings": { "author": "Leo P.", "rating": 4, "date": "1 week ago", "body": "Great fit and fast shipping. Would buy again." } },
        { "type": "review", "settings": { "author": "Sara K.", "rating": 5, "date": "3 weeks ago", "body": "My new favourite. So many compliments!" } }
      ]
    }
  ]
}
{% endschema %}
