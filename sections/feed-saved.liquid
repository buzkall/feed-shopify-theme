{% comment %}
  "Saved" (wishlist) page. Reads the bookmark list from localStorage (key
  `feed-saved`, an array of product handles) and fetches each product via the
  Shopify Ajax API (/products/{handle}.js). App-free.
{% endcomment %}

<div
  class="feed-saved color-{{ section.settings.color_scheme }}"
  style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;"
>
  <div class="feed-container" x-data="feedSaved()">
    <h1 class="mb-6 text-xl! font-semibold! text-feed-primary! dark:text-white!">{{ 'feed.save.saved_heading' | t }}</h1>

    <p x-show="loading" x-cloak class="text-sm text-feed-secondary dark:text-gray-400">{{ 'accessibility.loading' | t }}</p>

    <div x-show="!loading && savedProducts.length === 0" x-cloak class="py-12 text-center">
      <p class="text-feed-primary dark:text-gray-100">{{ 'feed.save.saved_empty' | t }}</p>
      <p class="mt-1 text-sm text-feed-secondary dark:text-gray-400">{{ 'feed.save.saved_empty_sub' | t }}</p>
      <a href="{{ routes.all_products_collection_url }}" class="feed-button-primary mt-4 inline-block">{{ 'general.continue_shopping' | t }}</a>
    </div>

    <ul x-show="!loading && savedProducts.length > 0" x-cloak role="list" class="feed-grid">
      <template x-for="p in savedProducts" :key="p.id">
        <li class="feed__item">
          <div class="group relative">
            <a :href="p.url" class="block">
              <div class="relative aspect-square overflow-hidden rounded-sm border border-feed-border bg-gray-100 dark:border-gray-800 dark:bg-gray-800">
                <template x-if="p.featured_image">
                  <img :src="p.featured_image + '&width=800'" :alt="p.title" width="800" height="800" loading="lazy" class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105">
                </template>
              </div>
              <div class="mt-2 px-1">
                <p class="truncate text-sm font-medium text-feed-primary dark:text-gray-100" x-text="p.title"></p>
                <p class="text-sm text-feed-secondary dark:text-gray-300" x-text="money(p.price)"></p>
              </div>
            </a>
            <button
              type="button"
              @click="removeSaved(p.handle)"
              class="absolute right-2 top-2 flex h-8 w-8 items-center justify-center rounded-full bg-white/80 text-feed-primary hover:bg-white dark:bg-black/50 dark:text-white"
              aria-label="{{ 'feed.save.unsave' | t }}"
            >
              <svg viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5">
                <path d="M17.593 3.322c1.1.128 1.907 1.077 1.907 2.185V21L12 17.25 4.5 21V5.507c0-1.108.806-2.057 1.907-2.185a48.507 48.507 0 0111.186 0z" />
              </svg>
            </button>
          </div>
        </li>
      </template>
    </ul>
  </div>
</div>

<script>
  document.addEventListener('alpine:init', () => {
    Alpine.data('feedSaved', () => ({
      savedProducts: [],
      loading: true,
      async init() {
        const handles = JSON.parse(localStorage.getItem('feed-saved') || '[]');
        if (!handles.length) {
          this.loading = false;
          return;
        }
        const results = await Promise.allSettled(
          handles.slice(0, 24).map((h) =>
            fetch('/products/' + h + '.js').then((r) => (r.ok ? r.json() : Promise.reject()))
          )
        );
        this.savedProducts = results.filter((r) => r.status === 'fulfilled').map((r) => r.value);
        this.loading = false;
      },
      removeSaved(handle) {
        const list = JSON.parse(localStorage.getItem('feed-saved') || '[]').filter((h) => h !== handle);
        localStorage.setItem('feed-saved', JSON.stringify(list));
        this.savedProducts = this.savedProducts.filter((p) => p.handle !== handle);
      },
      money(cents) {
        try {
          return new Intl.NumberFormat(document.documentElement.lang || undefined, {
            style: 'currency',
            currency: {{ cart.currency.iso_code | default: shop.currency | json }},
          }).format((cents || 0) / 100);
        } catch (e) {
          return ((cents || 0) / 100).toFixed(2);
        }
      },
    }));
  });
</script>

{% schema %}
{
  "name": "t:sections.feed_saved.name",
  "tag": "section",
  "class": "section-feed-saved",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "default": "scheme-1",
      "label": "t:sections.all.colors.label"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 48
    }
  ],
  "enabled_on": {
    "templates": ["page"]
  }
}
{% endschema %}
