{% comment %}
  This section is used in the 404 template to render page shown when customers
  enter an invalid store URL.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/404
{% endcomment %}

<div class="feed-container flex min-h-[50vh] flex-col items-center justify-center py-16 text-center">
  <p class="mb-4 text-sm text-feed-secondary dark:text-gray-400">{{ '404.title' | t }}</p>
  <h1 class="mb-8 text-3xl font-semibold text-feed-primary md:text-4xl dark:text-white">
    {{ '404.not_found' | t }}
  </h1>
  <a
    href="{{ routes.all_products_collection_url }}"
    class="rounded-md bg-feed-primary px-10 py-3 font-semibold text-white transition-opacity hover:opacity-90 dark:bg-white dark:text-feed-dark-bg"
  >
    {{ '404.back_to_shopping' | t }}
  </a>
</div>

{% schema %}
{
  "name": "t:general.404",
  "settings": []
}
{% endschema %}
