{% comment %}
  This section is used in the blog template to render the blog page listing all
  articles within a blog.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/blog
{% endcomment %}

<div class="feed-container py-8 md:py-12">
  <h1 class="mb-8 text-3xl font-semibold text-feed-primary dark:text-white">{{ blog.title }}</h1>

  {%- paginate blog.articles by 12 -%}
    {%- if blog.articles_count > 0 -%}
      <ul role="list" class="grid grid-cols-1 gap-x-6 gap-y-10 sm:grid-cols-2 lg:grid-cols-3">
        {%- for article in blog.articles -%}
          <li>
            <a href="{{ article.url }}" class="group block">
              {%- if article.image -%}
                <div class="aspect-[4/3] overflow-hidden rounded-md border border-feed-border bg-gray-100 dark:border-gray-800 dark:bg-gray-800">
                  {{
                    article.image
                    | image_url: width: 800
                    | image_tag:
                      loading: 'lazy',
                      widths: '300, 400, 600, 800',
                      sizes: '(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw',
                      class: 'h-full w-full object-cover transition-transform duration-300 group-hover:scale-105',
                      alt: article.title | escape
                  }}
                </div>
              {%- endif -%}
              <h2 class="mt-3 text-lg font-semibold text-feed-primary group-hover:opacity-70 dark:text-white">{{ article.title }}</h2>
              {%- assign date = article.published_at | time_tag: format: 'date' -%}
              <p class="mt-1 text-sm text-feed-secondary dark:text-gray-400">{{ 'blog.article_metadata_html' | t: date: date, author: article.author }}</p>
              {%- if article.excerpt.size > 0 -%}
                <p class="mt-2 text-sm text-feed-primary/80 dark:text-gray-300">{{ article.excerpt | strip_html | truncatewords: 20 }}</p>
              {%- endif -%}
            </a>
          </li>
        {%- endfor -%}
      </ul>

      {%- if paginate.pages > 1 -%}
        <nav class="mt-10 flex justify-center gap-4 text-sm text-feed-primary dark:text-white" role="navigation">
          {%- if paginate.previous -%}
            <a href="{{ paginate.previous.url }}" class="underline underline-offset-4 hover:opacity-70">{{ paginate.previous.title }}</a>
          {%- endif -%}
          {%- if paginate.next -%}
            <a href="{{ paginate.next.url }}" class="underline underline-offset-4 hover:opacity-70">{{ paginate.next.title }}</a>
          {%- endif -%}
        </nav>
      {%- endif -%}
    {%- endif -%}
  {%- endpaginate -%}
</div>

{% schema %}
{
  "name": "t:general.blog",
  "settings": []
}
{% endschema %}
