{% comment %}
  Feed-style collection banner.
  Renders the collection title (and optional description) inside the same
  `.feed-container` as the product grid, so they line up on the left edge.
{% endcomment %}

<div
  class="feed-collection-banner color-{{ section.settings.color_scheme }}"
  style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;"
>
  <div class="feed-container">
    <h1 class="text-2xl! font-semibold! text-feed-primary! dark:text-white! md:text-3xl!">
      {{- collection.title | escape -}}
    </h1>

    {%- if section.settings.show_description and collection.description != blank -%}
      <div class="feed-collection-banner__desc mt-2 max-w-2xl text-sm text-feed-secondary dark:text-gray-400">
        {{ collection.description }}
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "t:sections.main-collection-banner.name",
  "tag": "section",
  "class": "section-feed-collection-banner",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_description",
      "default": true,
      "label": "t:sections.main-collection-banner.settings.show_collection_description.label"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "default": "scheme-1",
      "label": "t:sections.all.colors.label"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 8
    }
  ]
}
{% endschema %}
