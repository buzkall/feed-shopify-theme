{% comment %}
  This section is used in the cart template to render /cart page with an
  overview of the items in customer's cart.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/cart
{% endcomment %}

<div class="feed-container py-8 md:py-12">
  <div class="mb-8 flex items-baseline justify-between gap-4">
    <h1 class="text-3xl font-semibold text-feed-primary dark:text-white">{{ 'cart.headline' | t }}</h1>
    <a
      href="{{ routes.all_products_collection_url }}"
      class="shrink-0 text-sm text-feed-primary underline underline-offset-4 hover:opacity-70 dark:text-white"
    >
      {{ 'cart.continue_shopping' | t }}
    </a>
  </div>

  {%- if cart.item_count == 0 -%}
    <p class="py-20 text-center text-lg text-feed-secondary dark:text-gray-400">{{ 'cart.empty' | t }}</p>
  {%- else -%}
    <form action="{{ routes.cart_url }}" method="post">
      <table class="w-full border-collapse text-feed-primary dark:text-white">
        <thead>
          <tr class="border-b border-feed-border text-xs uppercase tracking-wider text-feed-secondary dark:border-gray-800 dark:text-gray-400">
            <th class="py-3 text-left font-normal">{{ 'cart.product' | t }}</th>
            <th class="py-3 text-center font-normal">{{ 'cart.quantity' | t }}</th>
            <th class="py-3 text-right font-normal">{{ 'cart.total' | t }}</th>
          </tr>
        </thead>
        <tbody>
          {%- for item in cart.items -%}
            <tr class="border-b border-feed-border dark:border-gray-800">
              <td class="py-5">
                <div class="flex items-center gap-4">
                  <a href="{{ item.url }}" class="block w-20 shrink-0">
                    {%- if item.image -%}
                      {{ item.image | image_url: width: 160 | image_tag: widths: '80,160', class: 'w-full rounded-md', alt: item.product.title | escape }}
                    {%- endif -%}
                  </a>
                  <div class="min-w-0">
                    <a href="{{ item.url }}" class="font-medium hover:opacity-70">{{ item.product.title }}</a>
                    {%- unless item.product.has_only_default_variant -%}
                      <p class="mt-1 text-sm text-feed-secondary dark:text-gray-400">{{ item.variant.title }}</p>
                    {%- endunless -%}
                    <p class="mt-1 text-sm text-feed-secondary dark:text-gray-400">{{ item.original_price | money }}</p>
                  </div>
                </div>
              </td>
              <td class="py-5">
                <div class="flex items-center justify-center gap-3">
                  <div class="inline-flex items-center rounded-md border border-feed-border dark:border-gray-700">
                    <a
                      href="{{ routes.cart_change_url }}?line={{ forloop.index }}&quantity={{ item.quantity | minus: 1 }}"
                      class="flex h-9 w-9 items-center justify-center text-feed-secondary hover:text-feed-primary dark:hover:text-white"
                      aria-label="{{ 'cart.quantity' | t }} -1"
                    >−</a>
                    <span class="w-8 text-center text-sm">{{ item.quantity }}</span>
                    <a
                      href="{{ routes.cart_change_url }}?line={{ forloop.index }}&quantity={{ item.quantity | plus: 1 }}"
                      class="flex h-9 w-9 items-center justify-center text-feed-secondary hover:text-feed-primary dark:hover:text-white"
                      aria-label="{{ 'cart.quantity' | t }} +1"
                    >+</a>
                  </div>
                  <a
                    href="{{ routes.cart_change_url }}?line={{ forloop.index }}&quantity=0"
                    class="text-feed-secondary hover:text-feed-primary dark:hover:text-white"
                    aria-label="{{ 'cart.remove' | t }}"
                  >
                    <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M6 7h12M9 7V5a1 1 0 011-1h4a1 1 0 011 1v2m-7 0v12a1 1 0 001 1h6a1 1 0 001-1V7" />
                    </svg>
                  </a>
                </div>
              </td>
              <td class="py-5 text-right font-medium whitespace-nowrap">{{ item.final_line_price | money }}</td>
            </tr>
          {%- endfor -%}
        </tbody>
      </table>

      <div class="mt-8 flex flex-col items-end gap-2">
        <div class="flex items-baseline gap-4">
          <span class="text-feed-secondary dark:text-gray-400">{{ 'cart.estimated_total' | t }}</span>
          <span class="text-lg font-semibold text-feed-primary dark:text-white">{{ cart.total_price | money_with_currency }}</span>
        </div>
        <p class="text-sm text-feed-secondary dark:text-gray-400">{{ 'cart.taxes_note' | t }}</p>
        <button
          type="submit"
          name="checkout"
          class="mt-3 rounded-md bg-feed-primary px-14 py-3 font-semibold text-white transition-opacity hover:opacity-90 dark:bg-white dark:text-feed-dark-bg"
        >
          {{ 'cart.checkout' | t }}
        </button>
      </div>
    </form>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "t:general.cart",
  "settings": []
}
{% endschema %}
