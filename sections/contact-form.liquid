{% comment %}
  Contact form section, used by templates/page.contact.json.

  Wraps Shopify's `{% form 'contact' %}` in the theme's feed styling. Renders the
  success message after a post, and the validation errors returned by Shopify via
  the `default_errors` filter. Works without JavaScript.
{% endcomment %}

{%- liquid
  assign heading = section.settings.title | default: 'templates.contact.form.title' | t
-%}

<div
  class="feed-contact color-{{ section.settings.color_scheme }}"
  style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;"
>
  <div class="feed-container">
    <div class="mx-auto max-w-xl">
      {%- if heading != blank -%}
        <h2 class="mb-6 text-2xl! font-semibold! text-feed-primary! dark:text-white!">{{ heading | escape }}</h2>
      {%- endif -%}

      {%- form 'contact', id: 'ContactForm', class: 'flex flex-col gap-4' -%}
        {%- if form.posted_successfully? -%}
          <p
            class="rounded-md border border-feed-border bg-white px-4 py-3 text-sm text-feed-primary dark:border-gray-700 dark:bg-feed-dark-elevated dark:text-gray-100"
            role="status"
            tabindex="-1"
            autofocus
          >
            {{ 'templates.contact.form.post_success' | t }}
          </p>
        {%- elsif form.errors -%}
          <div
            class="rounded-md border border-red-300 bg-red-50 px-4 py-3 text-sm text-red-800 dark:border-red-800 dark:bg-red-950 dark:text-red-200"
            role="alert"
            tabindex="-1"
            autofocus
          >
            <h3 class="mb-1 font-semibold">{{ 'templates.contact.form.error_heading' | t }}</h3>
            <ul class="list-disc pl-5" role="list">
              {%- for field in form.errors -%}
                <li>
                  {%- if field == 'form' -%}
                    {{ form.errors.messages[field] }}
                  {%- else -%}
                    <a href="#ContactForm-{{ field }}" class="underline">
                      {{ form.errors.translated_fields[field] | capitalize }}
                      {{ form.errors.messages[field] }}
                    </a>
                  {%- endif -%}
                </li>
              {%- endfor -%}
            </ul>
          </div>
        {%- endif -%}

        <div>
          <label for="ContactForm-name" class="mb-1 block text-sm font-medium text-feed-primary dark:text-gray-100">
            {{ 'templates.contact.form.name' | t }}
          </label>
          <input
            type="text"
            id="ContactForm-name"
            name="contact[{{ 'templates.contact.form.name' | t }}]"
            value="{{ form.name | default: customer.name | escape }}"
            autocomplete="name"
            class="w-full rounded-md border border-gray-200 bg-gray-50 px-3 py-2 text-sm text-feed-primary outline-none focus:border-feed-primary focus:bg-white dark:border-gray-700 dark:bg-gray-800 dark:text-white dark:focus:border-gray-500"
          >
        </div>

        <div>
          <label for="ContactForm-email" class="mb-1 block text-sm font-medium text-feed-primary dark:text-gray-100">
            {{ 'templates.contact.form.email' | t }}
          </label>
          <input
            type="email"
            id="ContactForm-email"
            name="contact[email]"
            value="{{ form.email | default: customer.email | escape }}"
            autocomplete="email"
            autocapitalize="off"
            spellcheck="false"
            required
            {% if form.errors contains 'email' %}
              aria-invalid="true"
              aria-describedby="ContactForm-email-error"
            {% endif %}
            class="w-full rounded-md border border-gray-200 bg-gray-50 px-3 py-2 text-sm text-feed-primary outline-none focus:border-feed-primary focus:bg-white dark:border-gray-700 dark:bg-gray-800 dark:text-white dark:focus:border-gray-500"
          >
          {%- if form.errors contains 'email' -%}
            <p id="ContactForm-email-error" class="mt-1 text-sm text-red-700 dark:text-red-300">
              {{ form.errors.translated_fields.email | capitalize }}
              {{ form.errors.messages.email }}
            </p>
          {%- endif -%}
        </div>

        <div>
          <label for="ContactForm-phone" class="mb-1 block text-sm font-medium text-feed-primary dark:text-gray-100">
            {{ 'templates.contact.form.phone' | t }}
          </label>
          <input
            type="tel"
            id="ContactForm-phone"
            name="contact[{{ 'templates.contact.form.phone' | t }}]"
            value="{{ form.phone | default: customer.phone | escape }}"
            autocomplete="tel"
            class="w-full rounded-md border border-gray-200 bg-gray-50 px-3 py-2 text-sm text-feed-primary outline-none focus:border-feed-primary focus:bg-white dark:border-gray-700 dark:bg-gray-800 dark:text-white dark:focus:border-gray-500"
          >
        </div>

        <div>
          <label for="ContactForm-body" class="mb-1 block text-sm font-medium text-feed-primary dark:text-gray-100">
            {{ 'templates.contact.form.comment' | t }}
          </label>
          <textarea
            rows="6"
            id="ContactForm-body"
            name="contact[{{ 'templates.contact.form.comment' | t }}]"
            class="w-full rounded-md border border-gray-200 bg-gray-50 px-3 py-2 text-sm text-feed-primary outline-none focus:border-feed-primary focus:bg-white dark:border-gray-700 dark:bg-gray-800 dark:text-white dark:focus:border-gray-500"
          >{{ form.body }}</textarea>
        </div>

        <div>
          <button type="submit" class="feed-button-primary">
            {{ 'templates.contact.form.send' | t }}
          </button>
        </div>
      {%- endform -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.contact-form.name",
  "tag": "section",
  "class": "section-feed-contact",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "default": "Contact form",
      "label": "t:sections.contact-form.settings.title.label"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "default": "scheme-1",
      "label": "t:sections.all.colors.label"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 28
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 28
    }
  ],
  "presets": [
    {
      "name": "t:sections.contact-form.presets.name"
    }
  ]
}
{% endschema %}
