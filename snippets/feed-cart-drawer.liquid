{% comment %}
  Instagram-style slide-in cart drawer backed by an Alpine store and the Shopify
  Ajax cart API (/cart.js, /cart/add.js, /cart/change.js). Rendered globally so
  the header mini-cart, PDP add-to-cart and drawer all share one source of truth.
{% endcomment %}

<div
  x-data
  x-show="$store.cart.open"
  x-cloak
  class="fixed inset-0 z-[70]"
  role="dialog"
  aria-modal="true"
  aria-label="{{ 'sections.cart.title' | t }}"
>
  {%- comment -%} Backdrop {%- endcomment -%}
  <div
    x-show="$store.cart.open"
    x-transition.opacity
    @click="$store.cart.close()"
    class="absolute inset-0 bg-black/40"
  ></div>

  {%- comment -%} Panel {%- endcomment -%}
  <div
    x-show="$store.cart.open"
    x-transition:enter="transition ease-out duration-300"
    x-transition:enter-start="translate-x-full"
    x-transition:enter-end="translate-x-0"
    x-transition:leave="transition ease-in duration-200"
    x-transition:leave-start="translate-x-0"
    x-transition:leave-end="translate-x-full"
    x-trap.noscroll.inert="$store.cart.open"
    @keydown.escape.window="$store.cart.close()"
    tabindex="-1"
    class="absolute right-0 top-0 flex h-full w-full max-w-md flex-col bg-white shadow-xl dark:bg-feed-dark-bg"
  >
    <div class="flex items-center justify-between border-b border-feed-border px-4 py-3 dark:border-gray-800">
      <h2 class="text-base! font-semibold! text-feed-primary! dark:text-white!">
        {{ 'sections.cart.title' | t }} <span class="text-feed-secondary" x-text="'(' + $store.cart.item_count + ')'"></span>
      </h2>
      <button type="button" @click="$store.cart.close()" class="rounded-full p-2 text-feed-primary hover:bg-gray-100 dark:text-white dark:hover:bg-gray-800" aria-label="{{ 'accessibility.close' | t }}">
        <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="h-5 w-5"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
      </button>
    </div>

    {%- comment -%} Empty state {%- endcomment -%}
    <div x-show="$store.cart.item_count === 0" class="flex flex-1 flex-col items-center justify-center gap-4 p-8 text-center">
      <p class="text-feed-secondary dark:text-gray-400">{{ 'sections.cart.empty' | t }}</p>
      <a href="{{ routes.all_products_collection_url }}" @click="$store.cart.close()" class="feed-button-primary">{{ 'general.continue_shopping' | t }}</a>
    </div>

    {%- comment -%} Items {%- endcomment -%}
    <ul x-show="$store.cart.item_count > 0" role="list" class="flex-1 divide-y divide-feed-border overflow-y-auto px-4 dark:divide-gray-800">
      <template x-for="item in $store.cart.items" :key="item.key">
        <li class="flex gap-3 py-4">
          <a :href="item.url" class="block h-20 w-20 shrink-0 overflow-hidden rounded-md bg-gray-100 dark:bg-gray-800">
            <img :src="item.image" :alt="item.product_title" class="h-full w-full object-cover" width="80" height="80" loading="lazy">
          </a>
          <div class="min-w-0 flex-1">
            <a :href="item.url" class="block truncate text-sm font-medium text-feed-primary dark:text-gray-100" x-text="item.product_title"></a>
            <p class="truncate text-xs text-feed-secondary dark:text-gray-400" x-text="item.variant_title || ''"></p>
            <div class="mt-2 flex items-center justify-between">
              <div class="inline-flex items-center rounded-full border border-feed-border dark:border-gray-700">
                <button type="button" @click="$store.cart.change(item.key, item.quantity - 1)" class="px-2.5 py-1 text-feed-primary dark:text-gray-100" aria-label="{{ 'accessibility.decrease_quantity' | t }}"><span aria-hidden="true">&minus;</span></button>
                <span class="w-7 text-center text-sm text-feed-primary dark:text-gray-100" x-text="item.quantity"></span>
                <button type="button" @click="$store.cart.change(item.key, item.quantity + 1)" class="px-2.5 py-1 text-feed-primary dark:text-gray-100" aria-label="{{ 'accessibility.increase_quantity' | t }}"><span aria-hidden="true">+</span></button>
              </div>
              <span class="text-sm font-medium text-feed-primary dark:text-gray-100" x-text="$store.cart.money(item.final_line_price)"></span>
            </div>
            <button type="button" @click="$store.cart.change(item.key, 0)" class="mt-1 text-xs text-feed-secondary underline hover:text-feed-primary dark:text-gray-400 dark:hover:text-white">
              {{ 'sections.cart.remove_title' | t: title: '' | strip }}
            </button>
          </div>
        </li>
      </template>
    </ul>

    {%- comment -%} Footer {%- endcomment -%}
    <div x-show="$store.cart.item_count > 0" class="border-t border-feed-border p-4 dark:border-gray-800">
      <div class="mb-3 flex items-center justify-between">
        <span class="text-sm text-feed-secondary dark:text-gray-400">{{ 'sections.cart.estimated_total' | t }}</span>
        <span class="text-base font-semibold text-feed-primary dark:text-white" x-text="$store.cart.money($store.cart.total_price)"></span>
      </div>
      <button type="button" @click="$store.cart.checkout()" class="feed-button-primary w-full" :disabled="$store.cart.loading">{{ 'sections.cart.checkout' | t }}</button>
      <a href="{{ routes.cart_url }}" @click="$store.cart.close()" class="mt-2 block text-center text-sm text-feed-link hover:underline">{{ 'templates.cart.cart' | t }}</a>
    </div>
  </div>
</div>

<script>
  document.addEventListener('alpine:init', () => {
    Alpine.store('cart', {
      open: false,
      loading: false,
      item_count: {{ cart.item_count | default: 0 }},
      items: [],
      total_price: 0,
      currency: {{ cart.currency.iso_code | default: shop.currency | json }},
      money(cents) {
        try {
          return new Intl.NumberFormat(document.documentElement.lang || undefined, {
            style: 'currency',
            currency: this.currency,
          }).format((cents || 0) / 100);
        } catch (e) {
          return ((cents || 0) / 100).toFixed(2);
        }
      },
      _apply(cart) {
        this.item_count = cart.item_count;
        this.items = cart.items || [];
        this.total_price = cart.total_price || 0;
        if (cart.currency) this.currency = cart.currency;
      },
      async refresh() {
        const res = await fetch('{{ routes.cart_url }}.js');
        this._apply(await res.json());
      },
      openDrawer() {
        this.open = true;
        document.body.style.overflow = 'hidden';
        this.refresh();
      },
      close() {
        this.open = false;
        document.body.style.overflow = '';
      },
      async add(id, quantity) {
        this.loading = true;
        try {
          const res = await fetch('{{ routes.cart_add_url }}.js', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
            body: JSON.stringify({ id: id, quantity: quantity || 1 }),
          });
          if (!res.ok) {
            const err = await res.json();
            throw new Error(err.description || '{{ 'sections.cart.cart_error' | t }}');
          }
          this.openDrawer();
        } catch (e) {
          window.alert(e.message);
        } finally {
          this.loading = false;
        }
      },
      async change(key, quantity) {
        this.loading = true;
        try {
          const res = await fetch('{{ routes.cart_change_url }}.js', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
            body: JSON.stringify({ id: key, quantity: Math.max(0, quantity) }),
          });
          this._apply(await res.json());
        } finally {
          this.loading = false;
        }
      },
      checkout() {
        window.location.href = '/checkout';
      },
    });
  });
</script>
