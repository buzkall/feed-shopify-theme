{% comment %}
  Product card (shared by the feed grid and related products).
  Accepts:
  - card_product: a product object.
{% endcomment %}

{%- liquid
  assign second_image = card_product.media[1].preview_image | default: card_product.images[1]
  assign on_sale = false
  if card_product.compare_at_price > card_product.price and card_product.available
    assign on_sale = true
  endif
-%}

<a href="{{ card_product.url }}" class="group block">
  <div class="relative aspect-square overflow-hidden rounded-sm border border-feed-border bg-gray-100 dark:border-gray-800 dark:bg-gray-800">
    {%- if card_product.featured_media != blank -%}
      {{
        card_product.featured_media.preview_image
        | image_url: width: 800
        | image_tag:
          loading: 'lazy',
          widths: '300, 400, 600, 800',
          sizes: '(min-width: 768px) 33vw, 100vw',
          class: 'h-full w-full object-cover transition-transform duration-300 group-hover:scale-105',
          alt: card_product.featured_media.alt | default: card_product.title | escape
      }}
    {%- else -%}
      {{ 'product-apparel-1' | placeholder_svg_tag: 'h-full w-full object-cover' }}
    {%- endif -%}

    {%- if second_image != blank -%}
      {{
        second_image
        | image_url: width: 800
        | image_tag:
          loading: 'lazy',
          widths: '300, 400, 600, 800',
          sizes: '(min-width: 768px) 33vw, 100vw',
          class: 'absolute inset-0 hidden h-full w-full object-cover opacity-0 transition-opacity duration-300 group-hover:opacity-100 md:block',
          alt: ''
      }}
    {%- endif -%}

    {%- if on_sale -%}
      <span class="absolute left-2 top-2 rounded-full bg-red-500 px-2 py-0.5 text-xs font-semibold text-white">
        {{- 'products.product.on_sale' | t -}}
      </span>
    {%- endif -%}

    {%- comment -%} Desktop hover overlay (feed grid style) {%- endcomment -%}
    <div class="absolute inset-0 hidden items-center justify-center bg-black/40 px-2 text-center opacity-0 transition-opacity duration-200 group-hover:opacity-100 md:flex">
      <div class="text-white">
        <p class="line-clamp-2 text-sm font-medium">{{ card_product.title | escape }}</p>
        <p class="mt-1 text-sm">
          {%- if on_sale -%}<span class="line-through opacity-70">{{ card_product.compare_at_price | money }}</span> {% endif -%}
          {{ card_product.price | money }}
        </p>
      </div>
    </div>
  </div>

  {%- comment -%} Caption below the image (mobile feed style) {%- endcomment -%}
  <div class="mt-2 px-1 md:hidden">
    <p class="truncate text-sm font-medium text-feed-primary dark:text-gray-100">{{ card_product.title | escape }}</p>
    <p class="text-sm text-feed-secondary dark:text-gray-300">
      {%- if on_sale -%}<span class="line-through opacity-70">{{ card_product.compare_at_price | money }}</span> {% endif -%}
      {{ card_product.price | money }}
    </p>
  </div>
</a>
