{% comment %}
  Sort + filter bar for collection pages.
  Accepts:
  - facet_collection: the collection whose filters/sort options to render.

  Uses a plain GET form (full page reload) so filtering/sorting works without
  the Section Rendering API. `collection.products` automatically reflects the
  submitted filter/sort query params.
{% endcomment %}

{%- liquid
  assign active_total = 0
  for filter in facet_collection.filters
    assign active_total = active_total | plus: filter.active_values.size
  endfor
-%}

<form
  method="get"
  action="{{ facet_collection.url }}"
  x-data="{ open: null }"
  class="feed-facets mb-6 flex flex-wrap items-center gap-2"
>
  <span id="feed-facets-refresh-note" class="sr-only">{{ 'accessibility.refresh_page' | t }}</span>
  {%- for filter in facet_collection.filters -%}
    {%- assign active = filter.active_values.size -%}
    <div class="relative" @keydown.escape="open = null">
      <button
        type="button"
        @click="open = (open === {{ forloop.index }} ? null : {{ forloop.index }})"
        :aria-expanded="open === {{ forloop.index }}"
        class="inline-flex items-center gap-1 rounded-full border border-feed-border px-4 py-1.5 text-sm text-feed-primary transition-colors hover:bg-gray-50 dark:border-gray-700 dark:text-gray-100 dark:hover:bg-gray-800"
      >
        {{ filter.label | escape }}{% if active > 0 %} <span class="text-feed-link">({{ active }})</span>{% endif %}
        <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-4 w-4">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
        </svg>
      </button>

      <div
        x-show="open === {{ forloop.index }}"
        x-cloak
        @click.outside="open = null"
        class="absolute left-0 z-20 mt-2 max-h-72 w-60 overflow-y-auto rounded-lg border border-feed-border bg-white p-3 shadow-feed dark:border-gray-700 dark:bg-feed-dark-elevated"
      >
        {%- case filter.type -%}
          {%- when 'price_range' -%}
            <div class="space-y-2">
              <div class="flex items-center gap-2">
                <label class="flex-1">
                  <span class="sr-only">{{ 'products.facets.from' | t }}</span>
                  <input
                    type="number"
                    inputmode="decimal"
                    name="{{ filter.min_value.param_name }}"
                    value="{{ filter.min_value.value }}"
                    placeholder="{{ 'products.facets.from' | t }}"
                    min="0"
                    class="w-full rounded-md border border-feed-border px-2 py-1 text-sm dark:border-gray-700 dark:bg-gray-900 dark:text-gray-100"
                  >
                </label>
                <span class="text-feed-secondary">&ndash;</span>
                <label class="flex-1">
                  <span class="sr-only">{{ 'products.facets.to' | t }}</span>
                  <input
                    type="number"
                    inputmode="decimal"
                    name="{{ filter.max_value.param_name }}"
                    value="{{ filter.max_value.value }}"
                    placeholder="{{ 'products.facets.to' | t }}"
                    min="0"
                    class="w-full rounded-md border border-feed-border px-2 py-1 text-sm dark:border-gray-700 dark:bg-gray-900 dark:text-gray-100"
                  >
                </label>
              </div>
              <button type="submit" class="feed-button-primary w-full text-sm">{{ 'products.facets.apply' | t }}</button>
            </div>
          {%- else -%}
            <ul role="list" class="space-y-1.5">
              {%- for value in filter.values -%}
                <li>
                  <label class="flex items-center gap-2 text-sm text-feed-primary dark:text-gray-100 {% if value.count == 0 and value.active == false %}opacity-40{% endif %}">
                    <input
                      type="checkbox"
                      name="{{ value.param_name }}"
                      value="{{ value.value }}"
                      {% if value.active %}checked{% endif %}
                      {% if value.count == 0 and value.active == false %}disabled{% endif %}
                      onchange="this.form.submit()"
                      aria-describedby="feed-facets-refresh-note"
                      class="rounded border-feed-border text-feed-link focus:ring-feed-link"
                    >
                    <span>{{ value.label | escape }} <span class="text-feed-secondary">({{ value.count }})</span></span>
                  </label>
                </li>
              {%- endfor -%}
            </ul>
        {%- endcase -%}
      </div>
    </div>
  {%- endfor -%}

  {%- if active_total > 0 -%}
    <a href="{{ facet_collection.url }}" class="px-2 text-sm text-feed-link hover:underline">
      {{ 'products.facets.clear_all' | t }}
    </a>
  {%- endif -%}

  {%- if facet_collection.sort_options.size > 0 -%}
    <div class="ml-auto flex items-center gap-2">
      <label for="feed-sort" class="text-sm text-feed-secondary dark:text-gray-400">{{ 'products.facets.sort_by_label' | t }}</label>
      <select
        id="feed-sort"
        name="sort_by"
        onchange="this.form.submit()"
        aria-describedby="feed-facets-refresh-note"
        class="rounded-full border border-feed-border bg-white px-3 py-1.5 text-sm text-feed-primary dark:border-gray-700 dark:bg-feed-dark-elevated dark:text-gray-100"
      >
        {%- for option in facet_collection.sort_options -%}
          <option value="{{ option.value }}" {% if option.value == facet_collection.sort_by %}selected{% endif %}>
            {{ option.name }}
          </option>
        {%- endfor -%}
      </select>
    </div>
  {%- endif -%}
</form>
